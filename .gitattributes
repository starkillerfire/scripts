*.exe filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Preserve the exact bytes covered by signatures and approved launcher hashes.
*.ps1 -text whitespace=cr-at-eol
*.psm1 -text whitespace=cr-at-eol
*.bat -text whitespace=cr-at-eol

# Keep repository documentation and ignore rules consistent across platforms.
.gitignore text eol=lf
*.md text eol=lf
