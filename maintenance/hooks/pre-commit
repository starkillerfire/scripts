#!/bin/sh
# Library pre-commit checks: syntax, signatures, lint, and no binaries.
# Enable with maintenance/Install-GitHooks.ps1. Skip once: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
exec powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$root/maintenance/Test-StagedScripts.ps1"
